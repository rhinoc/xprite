  "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
    "oxfmt --config infra/oxfmt.json",
    "oxlint --config infra/oxlint.json"
  ],
  "*.{css,scss,html,json,jsonc}": "oxfmt --config infra/oxfmt.json",
  "**/index.ts": "node scripts/check/check-barrel-export-collisions.mjs",
