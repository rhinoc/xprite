{
  "$schema": "https://cdnstatic.tencentcs.com/edgeone/pages/docs/edgeone.schema.json",
  "name": "xprite",
  "nodeVersion": "24.5.0",
  "installCommand": "npx --yes pnpm@11.1.3 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.1.3 run build:editor",
  "outputDirectory": "apps/editor/dist",
  "redirects": [
    { "source": "$wwwhost", "destination": "$host", "statusCode": 301 },
    { "source": "/home", "destination": "/", "statusCode": 301 },
    { "source": "/home/", "destination": "/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/editor/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/editor",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/editor/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/release.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "caches": [
    { "source": "/", "cacheTtl": 0 },
    { "source": "/index.html", "cacheTtl": 0 },
    { "source": "/editor", "cacheTtl": 0 },
    { "source": "/editor/", "cacheTtl": 0 },
    { "source": "/sw.js", "cacheTtl": 0 },
    { "source": "/release.json", "cacheTtl": 0 },
    { "source": "/assets/*", "cacheTtl": 86400 }
  ]
}
