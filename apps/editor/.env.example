# Public project token, not a Personal API Key. Reporting is disabled when this is empty.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_REGION=US
# Optional; defaults to https://e.xprite.cc (US managed proxy) or https://eu.i.posthog.com.
VITE_POSTHOG_API_HOST=

# Deployment-only secret for source map uploads; never use a VITE_ prefix.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_RELEASE=
