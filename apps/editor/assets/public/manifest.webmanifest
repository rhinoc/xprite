{
  "id": "./editor",
  "name": "Xprite",
  "short_name": "Xprite",
  "description": "A browser-based pixel art editor that opens ASE sprite files.",
  "start_url": "./editor",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#202125",
  "theme_color": "#202125",
  "icons": [
    {
      "src": "./icon-192.png?v=xprite-3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png?v=xprite-3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg?v=xprite-3",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Editor",
      "short_name": "Editor",
      "url": "./editor",
      "icons": [{ "src": "./icon-192.png?v=xprite-3", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
