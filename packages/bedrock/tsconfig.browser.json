{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "composite": true,
    "paths": {
      "$/*": ["./browser/*"]
    },
    "tsBuildInfoFile": "../../node_modules/.tmp/bedrock-browser.tsbuildinfo"
  },
  "include": ["browser/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
