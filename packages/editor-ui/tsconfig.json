{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "declarationDir": "dist/types",
    "tsBuildInfoFile": "../../node_modules/.tmp/editor-ui.tsbuildinfo",
    "paths": { "$/*": ["./src/*", "../editor-core/src/*", "../ui/src/*"] }
  },
  "include": ["src"],
  "references": [
    { "path": "../editor-core/tsconfig.build.json" },
    { "path": "../ui/tsconfig.json" }
  ]
}
